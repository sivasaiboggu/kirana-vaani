  "accent": {
    "name": "marigold",
    "hex": "#d97706",
    "oklch": "oklch(0.666 0.157 58.3)",
    "deep": "#b45309",
    "reasoning": "Marigold is the flower on every Indian shop counter — the one warm note against ink-green and paper. It is used only where attention is needed (mic, speaking ring, wave bars while speaking, low-stock and restock marks, eyebrow labels), under 10% of any screen. The deep variant #b45309 carries the mic button because white on #d97706 is only 3.19:1; white on #b45309 is 5.02:1."
  },
  "type": {
    "display": "Georgia, Iowan Old Style, Times New Roman, Noto Serif Tamil, Noto Serif Telugu, Noto Serif Devanagari, Noto Serif Kannada, Noto Serif Malayalam, serif",
    "text": "-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Noto Sans, Noto Sans Tamil, Noto Sans Telugu, Noto Sans Devanagari, Noto Sans Kannada, Noto Sans Malayalam, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, Liberation Mono, monospace",
    "notes": "Display serif reads like a painted shop signboard; the system sans keeps all seven scripts legible; mono is only for machine strings (UPI link, timers, code). Money always uses tabular numerals."
  },
